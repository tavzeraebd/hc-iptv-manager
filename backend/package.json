{
  "name": "iptv-manager-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend do IPTV Manager (gerenciamento de acessos IPTV)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "build:mobile": "esbuild src/mobile-entry.ts --bundle --platform=node --target=node18 --format=cjs --external:bridge --external:@supabase/supabase-js --outfile=../frontend/public/nodejs/main.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

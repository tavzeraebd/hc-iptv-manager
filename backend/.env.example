# IPTV Manager backend — variáveis de ambiente
# Copie para .env (NÃO commite o .env real) ou defina no painel do host.

# --- Portal hospedado (Supabase) ---------------------------------------------
# Deixe as duas em branco para persistir em arquivo (data/usuarios.txt e
# data/devices.txt) — é o modo do backend embarcado no APK e do dev local.
# Preencha as duas para persistir no Postgres do Supabase.
SUPABASE_URL=
# API Keys -> Secret keys (começa com sb_secret_...). NUNCA vai pro frontend/APK.
SUPABASE_SECRET_KEY=

# --- Autenticação da API ----------------------------------------------------
# Token exigido no header `x-portal-token` em TODAS as rotas, exceto
# POST /api/devices/heartbeat (que o Player usa e continua pública).
# Em branco = API aberta (só aceitável no backend embarcado, que escuta em
# 127.0.0.1 dentro do próprio app). Num portal público, defina SEMPRE.
PORTAL_ADMIN_TOKEN=

# --- Pagamento / renovação (Mercado Pago PIX) ---------------------------------
# Sem MP_ACCESS_TOKEN, as rotas de pagamento respondem 503 e o Player não mostra
# o botão "Renovar acesso". Preço/meses são editáveis no Manager (não são env).
#   Painel: https://www.mercadopago.com.br/developers -> Suas integrações -> app
#   Produção: APP_USR-...   |   Sandbox: TEST-...  (as de produção precisam ser
#   ativadas no painel: Indústria + Website + termos)
MP_ACCESS_TOKEN=
# Painel MP -> seu app -> Webhooks -> "Assinatura secreta". Valida o x-signature.
MP_WEBHOOK_SECRET=
# URL pública do portal — usada pra montar o notification_url do webhook.
PORTAL_PUBLIC_URL=

# --- Metadados enriquecidos (TMDB) -----------------------------------------
# Sem TMDB_API_KEY, GET /api/meta só lê o cache e responde found:false — o app
# segue com o pôster/sinopse que o painel Xtream fornece. Com a chave, o portal
# busca no TMDB (search + details + credits + videos), cacheia em tmdb_meta e
# passa a devolver pôster HD, sinopse pt-BR (fallback en-US), nota, elenco,
# diretor, trailer do YouTube e duração.
#   Painel: https://www.themoviedb.org/settings/api
#   Aceita a "API Key (v3 auth)" (32 hex) OU o "API Read Access Token (v4)".
TMDB_API_KEY=

# --- Rede -----------------------------------------------------------------
# A maioria dos hosts (Render/Fly/Railway) injeta PORT automaticamente.
PORT=3001
HOST=0.0.0.0

# --- Só no modo arquivo ---------------------------------------------------
# Onde gravar usuarios.txt / devices.txt (padrão: ../data ao lado do backend).
DATA_DIR=
